<Window x:Class="EmailClient.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:EmailClient.UI.ViewModels"
        Title="GGTU Email Client" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Command="{Binding AddEmailBoxCommand}" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📧" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Add Email Box"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding RemoveEmailBoxCommand}" 
                    CommandParameter="{Binding SelectedEmailBox}"
                    Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="❌" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Remove Email Box"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding RefreshCommand}" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ComposeCommand}" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✉" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="New Email"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteCommand}" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Delete"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Email Boxes and Folders Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Email Boxes ComboBox -->
                <ComboBox Grid.Row="0"
                         ItemsSource="{Binding EmailBoxes}"
                         SelectedItem="{Binding SelectedEmailBox}"
                         Margin="5"
                         Padding="5">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Folders TreeView -->
                <TreeView Grid.Row="1" 
                         Margin="5"
                         Background="#F5F5F5">
                    <TreeViewItem Header="{Binding SelectedEmailBox.DisplayName}"
                                IsExpanded="True">
                        <TreeViewItem.ItemsSource>
                            <Binding Path="Folders"/>
                        </TreeViewItem.ItemsSource>
                        <TreeViewItem.ItemTemplate>
                            <HierarchicalDataTemplate>
                                <StackPanel Orientation="Horizontal"
                                          MouseLeftButtonDown="Folder_MouseLeftButtonDown">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeViewItem.ItemTemplate>
                    </TreeViewItem>
                </TreeView>
            </Grid>
            <!-- Email List and Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Email List -->
                <ListView ItemsSource="{Binding Emails}" 
                         SelectedItem="{Binding SelectedEmail}"
                         Grid.Row="0" 
                         Margin="5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="From" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding From}" 
                                                 TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Subject" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Subject}" 
                                                 TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Date" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Date, StringFormat=g}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <GridSplitter Grid.Row="1" 
                             Height="5" 
                             HorizontalAlignment="Stretch"/>

                <!-- Message Content -->
                <Border Grid.Row="2" 
                        Margin="5" 
                        BorderBrush="LightGray" 
                        BorderThickness="1">
                    <ScrollViewer>
                        <StackPanel Margin="10">
                            <!-- Message Header -->
                            <Border Background="#F8F9FA" 
                                    Padding="10" 
                                    Margin="0,0,0,15" 
                                    BorderBrush="#DEE2E6" 
                                    BorderThickness="1" 
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="Информация о письме" 
                                             FontWeight="Bold" 
                                             FontSize="18" 
                                             Margin="0,0,0,10"/>

                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Тема:" 
                                                 FontWeight="SemiBold" 
                                                 Grid.Row="0"/>
                                        <TextBlock Text="{Binding SelectedEmail.Subject}" 
                                                 Grid.Row="0" 
                                                 Grid.Column="1" 
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,5"/>

                                        <TextBlock Text="От:" 
                                                 FontWeight="SemiBold" 
                                                 Grid.Row="1"/>
                                        <TextBlock Text="{Binding SelectedEmail.From}" 
                                                 Grid.Row="1" 
                                                 Grid.Column="1"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,5"/>

                                        <TextBlock Text="Кому:" 
                                                 FontWeight="SemiBold" 
                                                 Grid.Row="2"/>
                                        <TextBlock Text="{Binding SelectedEmail.To[0]}" 
                                                 Grid.Row="2" 
                                                 Grid.Column="1"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,5"/>

                                        <TextBlock Text="Дата:" 
                                                 FontWeight="SemiBold" 
                                                 Grid.Row="3"/>
                                        <TextBlock Text="{Binding SelectedEmail.Date, StringFormat=g}" 
                                                 Grid.Row="3" 
                                                 Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Message Content -->
                            <Border Background="White" 
                                    Padding="15" 
                                    BorderBrush="#DEE2E6" 
                                    BorderThickness="1" 
                                    CornerRadius="4">
                                <DockPanel>
                                    <TextBlock Text="Содержание письма" 
                                             FontWeight="Bold" 
                                             FontSize="16" 
                                             Margin="0,0,0,10"
                                             DockPanel.Dock="Top"/>

                                    <TextBox Text="{Binding SelectedEmail.Body, Mode=OneWay}" 
                                            TextWrapping="Wrap"
                                            IsReadOnly="True"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled"
                                            FontFamily="Segoe UI"
                                            FontSize="14"
                                            Padding="10"
                                            AcceptsReturn="True"
                                            IsReadOnlyCaretVisible="True"
                                            SelectionBrush="#ADD8E6"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" 
              Grid.RowSpan="3" 
              Panel.ZIndex="1000"
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                <ProgressBar Width="100" 
                           Height="2" 
                           IsIndeterminate="True"/>
                <TextBlock Text="{Binding StatusMessage}"
                         Foreground="White" 
                         HorizontalAlignment="Center" 
                         Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>