<Window x:Class="EmailClient.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmailClient.UI"
        mc:Ignorable="d"
        Title="Email Login" 
        Height="700" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Window.Resources>
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="InputField" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            Margin="20" 
            CornerRadius="8" 
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Provider Selection -->
                <RowDefinition Height="Auto"/>
                <!-- Provider Instructions -->
                <RowDefinition Height="Auto"/>
                <!-- Email -->
                <RowDefinition Height="Auto"/>
                <!-- Password -->
                <RowDefinition Height="Auto"/>
                <!-- Custom Settings -->
                <RowDefinition Height="*"/>
                <!-- Spacing -->
                <RowDefinition Height="Auto"/>
                <!-- Error Message -->
                <RowDefinition Height="Auto"/>
                <!-- Login Button -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" 
                      Text="Sign in to your email" 
                      FontSize="24" 
                      FontWeight="Light"
                      Margin="0,0,0,20"/>

            <!-- Provider Selection -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Email Provider" Style="{StaticResource InputLabel}"/>
                <ComboBox ItemsSource="{Binding AvailableProviders}"
                         SelectedItem="{Binding SelectedProvider}"
                         Style="{StaticResource InputField}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ProviderToDisplayNameConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Provider Instructions -->
            <TextBlock Grid.Row="2" 
                      Text="{Binding ProviderInstructions}"
                      TextWrapping="Wrap"
                      Margin="0,0,0,15"
                      Foreground="#666666"/>

            <!-- Email Input -->
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Email Address" Style="{StaticResource InputLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource InputField}"/>
            </StackPanel>

            <!-- Password Input -->
            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock Text="Password" Style="{StaticResource InputLabel}"/>
                <Grid>
                    <PasswordBox x:Name="PasswordBox"
                               Style="{StaticResource InputField}"/>
                    <TextBox x:Name="PasswordText"
                            Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource InputField}"
                            Visibility="Collapsed"/>
                    <Button HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="0,0,10,15"
                            Padding="5"
                            Click="TogglePassword_Click"
                            Background="Transparent"
                            BorderThickness="0">
                        <TextBlock x:Name="ShowPasswordIcon" 
                                 Text="👁"
                                 FontSize="16"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Custom Server Settings -->
            <StackPanel Grid.Row="5" 
              Visibility="{Binding IsCustomServer, Converter={StaticResource BooleanToVisibilityConverter}}"
              Margin="0,10,0,0">
                <TextBlock Text="Custom Server Settings" 
                 FontWeight="SemiBold" 
                 Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="POP3 Server" Margin="0,0,0,5"/>
                    <TextBlock Text="Port" Grid.Column="1" Margin="5,0,0,5"/>

                    <TextBox Grid.Row="1" 
                    Text="{Binding CustomSettings.PopServer}"
                    Margin="0,0,5,0"
                    Padding="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                    Text="{Binding CustomSettings.PopPort}"
                    Padding="5"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="SMTP Server" Margin="0,0,0,5"/>
                    <TextBlock Text="Port" Grid.Column="1" Margin="5,0,0,5"/>

                    <TextBox Grid.Row="1"
                    Text="{Binding CustomSettings.SmtpServer}"
                    Margin="0,0,5,0"
                    Padding="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                    Text="{Binding CustomSettings.SmtpPort}"
                    Padding="5"/>
                </Grid>

                <CheckBox Content="Use SSL/TLS"
                  IsChecked="{Binding CustomSettings.RequiresSsl}"/>
            </StackPanel>

            <!-- Error Message -->
            <TextBox Grid.Row="7" 
                    Text="{Binding ErrorMessage, Mode=OneWay}"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="Red"
                    Margin="0,10"/>

            <!-- Login Button -->
            <Button Grid.Row="8"
                    Content="{Binding IsLoading, Converter={StaticResource LoadingTextConverter}}"
                    Command="{Binding LoginCommand}"
                    Height="44"
                    FontSize="14"
                    Background="#0078D4"
                    Foreground="White"
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Loading Overlay -->
            <Grid Grid.Row="0" Grid.RowSpan="9"
                  Background="#80000000"
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" 
                          VerticalAlignment="Center">
                    <ProgressBar Width="100" 
                               Height="2" 
                               IsIndeterminate="True"
                               Background="Transparent"
                               BorderThickness="0"/>
                    <TextBlock Text="Connecting..." 
                             Foreground="White"
                             HorizontalAlignment="Center"
                             Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>